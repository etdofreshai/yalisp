      "tags": ["evaluation-order", "effects", "mutation"],
      "stages": ["seed", "bootstrap"],
      "setup": ["(define order 0)", "(define mark (lambda (x) (begin (set! order (+ (* order 10) x)) x)))"],
      "events": [{
        "id": "evaluate",
