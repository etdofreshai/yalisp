        {
          "id": "mutate",
          "kind": "value",
          "source": "(set! counter (+ counter 4))",
          "probes": [{"name": "counter", "source": "counter"}],
          "effectProbes": [{"channel": "mutation", "name": "counter", "source": "counter"}],
          "expected": {"value": "5", "printedOutput": "5", "effects": [{"channel": "mutation", "name": "counter", "value": "5"}], "error": null, "probes": [{"name": "counter", "value": "5"}]}
        },
        {
          "id": "observe",
          "kind": "value",
          "source": "counter",
          "probes": [{"name": "counter", "source": "counter"}],
          "effectProbes": [],
          "expected": {"value": "5", "printedOutput": "5", "effects": [], "error": null, "probes": [{"name": "counter", "value": "5"}]}
        }
      ]
    },
    {
      "id": "closure-capture",
      "tags": ["closure", "mutation", "scope"],
      "stages": ["seed", "bootstrap"],
      "setup": ["(define base 10)", "(define add-base (lambda (x) (+ base x)))"],
      "events": [
        {
          "id": "rebind",
          "kind": "value",
          "source": "(set! base 20)",
          "probes": [{"name": "base", "source": "base"}],
          "effectProbes": [{"channel": "mutation", "name": "base", "source": "base"}],
          "expected": {"value": "20", "printedOutput": "20", "effects": [{"channel": "mutation", "name": "base", "value": "20"}], "error": null, "probes": [{"name": "base", "value": "20"}]}
        },
        {
          "id": "call",
          "kind": "value",
          "source": "(add-base 22)",
          "probes": [{"name": "base", "source": "base"}],
          "effectProbes": [],
          "expected": {"value": "42", "printedOutput": "42", "effects": [], "error": null, "probes": [{"name": "base", "value": "20"}]}
        }
      ]
    },
    {
