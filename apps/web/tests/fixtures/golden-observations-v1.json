        "source": "(+ (mark 1) (mark 2))",
        "probes": [{"name": "order", "source": "order"}],
        "effectProbes": [{"channel": "mutation-order", "name": "order", "source": "order"}],
        "expected": {"value": "3", "printedOutput": "3", "effects": [{"channel": "mutation-order", "name": "order", "value": "12"}], "error": null, "probes": [{"name": "order", "value": "12"}]}
      }]
