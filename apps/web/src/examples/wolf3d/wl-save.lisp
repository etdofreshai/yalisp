(defn wl.copy-save! (save at source count)
  (bytes.copy save at source 0 count))

(defn wl.copy-load! (target save at count)
  (bytes.copy target 0 save at count))

;;; Non-SPEAR saves persist eight ten-byte LRstruct rows immediately after
;;; gamestate. The fifth element in the port's transient completion result is
;;; the just-awarded bonus, not part of the source LevelRatios structure.
(defn wl.write-level-ratios (save index)
  (if (= index 8)
      save
      (let ((ratio (wl.ratio-or-zero index))
            (at (+ wl.SAVE-LEVELRATIOS (* index 10))))
        (begin
          (wl.save-i16! save at (wl.play-at ratio 0))
          (wl.save-i16! save (+ at 2) (wl.play-at ratio 1))
          (wl.save-i16! save (+ at 4) (wl.play-at ratio 2))
          (u32! save (+ at 6) (wl.play-at ratio 3))
          (wl.write-level-ratios save (+ index 1))))))

(defn wl.read-level-ratios (save index ratios)
  (if (= index 8)
      ratios
      (let ((at (+ wl.SAVE-LEVELRATIOS (* index 10))))
        (wl.read-level-ratios save (+ index 1)
          (append ratios
            (list (list (i16@ save at) (i16@ save (+ at 2))
                        (i16@ save (+ at 4)) (i32@ save (+ at 6)))))))))

