    (wl.save-i16! save 0 wl.difficulty)
    (wl.save-i16! save 2 wl.map)
    (u32! save 4 wl.oldscore)
    (u32! save 8 wl.score)
    (u32! save 12 wl.nextextra)
    (wl.save-i16! save 16 wl.lives)
    (wl.save-i16! save 18 wl.health)
    (wl.save-i16! save 20 wl.ammo)
    (wl.save-i16! save 22 wl.keys)
    (wl.save-i16! save 24 wl.bestweapon)
    (wl.save-i16! save 26 wl.weapon)
    (wl.save-i16! save 28 wl.chosenweapon)
    (wl.save-i16! save 30 wl.faceframe)
    (wl.save-i16! save 32 wl.attackframe)
    (wl.save-i16! save 34 wl.attackcount)
    (wl.save-i16! save 36 wl.weaponframe)
    (wl.save-i16! save 38 wl.episode)
    (wl.save-i16! save 40 wl.secretcount)
    (wl.save-i16! save 42 wl.treasurecount)
    (wl.save-i16! save 44 wl.killcount)
    (wl.save-i16! save 46 wl.secrettotal)
    (wl.save-i16! save 48 wl.treasuretotal)
