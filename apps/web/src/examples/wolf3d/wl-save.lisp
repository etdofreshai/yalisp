(defn wl.do-checksum (source at size checksum)
  (if (<= size 1)
      checksum
      (wl.do-checksum source (+ at 1) (- size 1)
                      (+ checksum (bit.xor (u8@ source at)
                                           (u8@ source (+ at 1)))))))

(defn wl.save-checksum (save)
  (let ((a (wl.do-checksum save wl.SAVE-GAMESTATE 68 0)))
    (let ((b (wl.do-checksum save wl.SAVE-LEVELRATIOS 80 a)))
      (let ((c (wl.do-checksum save wl.SAVE-TILEMAP 4096 b)))
        (let ((d (wl.do-checksum save wl.SAVE-ACTORAT-WALL 4096 c)))
          (let ((e (wl.do-checksum save wl.SAVE-ACTORAT 4096 d)))
            (let ((f (wl.do-checksum save wl.SAVE-STATICCOUNT 2402 e)))
              (let ((g (wl.do-checksum save wl.SAVE-DOORNUM 578 f)))
                (wl.do-checksum save wl.SAVE-PWALL 10 g)))))))))

(defn wl.save-the-game ()
  (let ((save (bytes.alloc wl.SAVE-BYTES)))
    (begin
      (wl.write-owned-state save)
      (u32! save wl.SAVE-CHECKSUM (wl.save-checksum save))
      save)))

(defn wl.load-the-game (save)
  (if (or (nil? save) (not (= (bytes.length save) wl.SAVE-BYTES)))
      false
      (let ((checksum (wl.save-checksum save)))
        (let ((oldchecksum (u32@ save wl.SAVE-CHECKSUM)))
          (begin
            (wl.read-owned-state save)
            (set! wl.loadedgame 1)
            (if (= oldchecksum checksum)
                true
                (begin
                  ;; Preserve the original anti-cheat recovery values.
                  (set! wl.score 0)
                  (set! wl.lives 1)
                  (set! wl.weapon wl.WP-PISTOL)
                  (set! wl.chosenweapon wl.WP-PISTOL)
                  (set! wl.bestweapon wl.WP-PISTOL)
                  (set! wl.ammo 8)
                  false)))))))
